# SmartNotes Environment Configuration
# Flask Secret Key for session signing
SECRET_KEY=smartnotes-super-secret-key-change-in-production

# Database Connection URL
# For production (e.g. Neon PostgreSQL, Vercel Postgres, Supabase):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# If left empty locally, SmartNotes will automatically use local SQLite (sqlite:///smartnotes.db)
